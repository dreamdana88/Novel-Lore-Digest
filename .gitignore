# User source files and generated analysis artifacts
source_raw/*
!source_raw/.gitkeep

workspace/source/*
!workspace/source/.gitkeep

workspace/index/*
!workspace/index/.gitkeep

workspace/notes/*
!workspace/notes/story-notes/
!workspace/notes/chapter-notes/
!workspace/notes/arc-notes/

workspace/notes/story-notes/*
!workspace/notes/story-notes/.gitkeep
workspace/notes/chapter-notes/*
!workspace/notes/chapter-notes/.gitkeep
workspace/notes/arc-notes/*
!workspace/notes/arc-notes/.gitkeep

workspace/entities/*
!workspace/entities/.gitkeep

outputs/*
!outputs/.gitkeep
!outputs/SillyTavern角色汇总/
outputs/SillyTavern角色汇总/*
!outputs/SillyTavern角色汇总/.gitkeep

!outputs/star-forge-import/
outputs/star-forge-import/*
!outputs/star-forge-import/.gitkeep

# Common ebook and document source formats
*.epub
*.pdf
*.mobi
*.azw3

# Python and OS/editor artifacts
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
.idea/
.vscode/

